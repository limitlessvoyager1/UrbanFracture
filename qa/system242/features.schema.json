{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QA242 semantic feature registry",
  "type": "object",
  "required": [
    "schema",
    "coverage",
    "mandatorySmoke",
    "features"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "coverage": {
      "type": "string",
      "enum": [
        "pilot",
        "complete"
      ]
    },
    "mandatorySmoke": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner",
          "sources",
          "entities",
          "dependsOn",
          "suites",
          "visualScenarios",
          "performanceRisk",
          "specs",
          "contentIds",
          "certification"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "entities": {
            "type": "object",
            "required": [
              "characters",
              "moves",
              "systems",
              "levels"
            ],
            "additionalProperties": false,
            "properties": {
              "characters": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "moves": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "systems": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "levels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "suites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "visualScenarios": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "performanceRisk": {
            "type": "boolean"
          },
          "specs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "contentIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "certification": {
            "type": "string",
            "enum": [
              "partial",
              "pending",
              "approved"
            ]
          }
        }
      },
      "minItems": 1
    }
  }
}
